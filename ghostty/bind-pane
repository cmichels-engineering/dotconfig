# split pane bindings



# panes
keybind = ctrl+shift+alt+i=new_split:right
keybind = ctrl+shift+alt+u=new_split:down
keybind = ctrl+shift+alt+equal=equalize_splits
keybind = ctrl+shift+alt+p=toggle_split_zoom

# nav
keybind = ctrl+shift+alt+l=goto_split:right
keybind = ctrl+shift+alt+j=goto_split:bottom
keybind = ctrl+shift+alt+h=goto_split:left
keybind = ctrl+shift+alt+k=goto_split:top

# sizing
keybind = ctrl+shift+alt+m=resize_split:down,10
keybind = ctrl+shift+alt+.=resize_split:left,10
keybind = ctrl+shift+alt+,=resize_split:up,10
keybind = ctrl+shift+alt+n=resize_split:right,10
