#compdef ghostty

# Ghostty terminal emulator zsh completion
# Actions use +action syntax; config keys are available as --key=value flags

local -a actions
actions=(
  '+version:print version information'
  '+help:show help'
  '+list-fonts:list available fonts'
  '+list-keybinds:list current or default keybindings'
  '+list-themes:list available themes'
  '+list-colors:list terminal colors'
  '+list-actions:list all available keybind actions'
  '+show-config:show current configuration'
  '+validate-config:validate configuration file'
  '+show-face:show font face for a codepoint'
  '+crash-report:manage crash reports'
)

