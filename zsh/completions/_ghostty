_ghostty() {
  local state

  # Handle +action as the first argument
  if [[ ${words[2]} == +* ]] || [[ ${#words[@]} -eq 2 && $words[2] == +* ]]; then
    # Already have an action, complete its flags
    case ${words[2]} in
      +list-keybinds)
        _arguments \
          '--default[show default keybinds]' \
          '--plain[disable formatting]' \
          '--docs[show documentation for each action]'
        return
        ;;
      +show-config)
        _arguments \
          '--default[show default config instead of user config]' \
          '--docs[include documentation comments]'
        return
        ;;
      +list-themes|+list-fonts|+list-colors|+list-actions|+version|+help|+validate-config|+crash-report)
        return
        ;;
    esac
  fi

  # Complete actions (+action) and config flags (--key=value)
  _arguments -C \
    '-e[run command inside terminal]:command:_command_names' \
    ':action or option:->main'

  case $state in
    main)
      # Offer +actions and --config-keys
      _describe 'action' actions
      compadd -S '' -- "${config_keys[@]}"
      ;;
  esac
}

_ghostty "$@"
